      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.optimize import minimize\n",
        "from scipy.stats import poisson\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd"
      ],
      "metadata": {
        "id": "7lRdtMeEn7vP"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def rhodixon(x,y,lamb,mu,phi):\n",
        "      if x==0 and y==0:\n",
        "        return 1-lamb*mu*phi\n",
        "      elif x==0 and y==1:\n",
        "        return 1+lamb*phi\n",
        "      elif x==1 and y==0:\n",
        "        return 1+mu*phi\n",
        "      elif x==1 and y==1:\n",
        "        return 1-phi\n",
        "      else:\n",
        "        return 1"
      ],
      "metadata": {
        "id": "-FsoyxZfoAIh"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def prob_a_american(proba_individual):\n",
        "\n",
        "    decimal = 1/proba_individual\n",
        "\n",
        "    if decimal >= 2:\n",
        "        return round((decimal-1)*100)\n",
        "    else:\n",
        "        return round(-100/(decimal-1))\n",
        "#%%\n",
        "\n"
      ],
      "metadata": {
        "id": "jHm8rlE4pQAX"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def score_matrix(prob,\n",
        "                      equipo_local=\"Local\",\n",
        "                      equipo_visitante=\"Visitante\",\n",
        "                      mostrar_porcentaje=True,\n",
        "                      cmap=\"Blues\"):\n",
        "\n",
        "    n = prob.shape[0]\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(8,8))\n",
        "\n",
        "    # Heatmap\n",
        "    im = ax.imshow(prob, cmap=cmap)\n",
        "\n",
        "    # Barra de color\n",
        "    cbar = plt.colorbar(im)\n",
        "    cbar.set_label(\"Probabilidad\")\n",
        "\n",
        "    # Diagonal\n",
        "    ax.plot([-0.5,n-0.5],[-0.5,n-0.5],\n",
        "            color=\"black\",\n",
        "            linewidth=2)\n",
        "\n",
        "    # Texto en cada celda\n",
        "    for i in range(n):\n",
        "        for j in range(n):\n",
        "\n",
        "            if i > j:\n",
        "                color = \"green\"\n",
        "            elif i == j:\n",
        "                color = \"black\"\n",
        "            else:\n",
        "                color = \"red\"\n",
        "\n",
        "            if mostrar_porcentaje:\n",
        "                texto = f\"{100*prob[i,j]:.1f}%\"\n",
        "            else:\n",
        "                texto = f\"{prob[i,j]:.3f}\"\n",
        "\n",
        "            ax.text(j,\n",
        "                    i,\n",
        "                    texto,\n",
        "                    ha=\"center\",\n",
        "                    va=\"center\",\n",
        "                    color=color,\n",
        "                    fontsize=8)\n",
        "\n",
        "    ax.set_xticks(range(n))\n",
        "    ax.set_yticks(range(n))\n",
        "\n",
        "    ax.set_xlabel(f\"Goles {equipo_visitante}\", fontsize=12)\n",
        "    ax.set_ylabel(f\"Goles {equipo_local}\", fontsize=12)\n",
        "\n",
        "    ax.set_title(f\"{equipo_local} vs {equipo_visitante}\",\n",
        "                 fontsize=16,\n",
        "                 fontweight=\"bold\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "\n",
        "    return fig"
      ],
      "metadata": {
        "id": "U9DoU_s5pWmL"
      },
      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": 9,
      "metadata": {
        "id": "cmaVPxzEnTE2"
      },
      "outputs": [],
      "source": [
        "class DixonColes:\n",
        "\n",
        "    def __init__(self, xi=None):\n",
        "        \"\"\"\n",
        "        xi=None  -> Dixon-Coles clásico\n",
        "        xi=0.0065 -> Dixon-Coles con decaimiento temporal\n",
        "        \"\"\"\n",
        "\n",
        "        self.xi = xi\n",
        "\n",
        "        # parámetros del modelo\n",
        "        self.ataque = None\n",
        "        self.defensa = None\n",
        "        self.gamma = None\n",
        "        self.rho = None\n",
        "\n",
        "        self.logLik = None\n",
        "        self.resultado = None\n",
        "        self.fitted = False\n",
        "        if xi is None:\n",
        "          self.model = \"Dixon-Coles\"\n",
        "        else:\n",
        "          self.model = \"Dixon-Coles Time Decay\"\n",
        "\n",
        "        # información auxiliar\n",
        "        self.equipos = None\n",
        "        self.indice = None\n",
        "\n",
        "    def fit(self, df):\n",
        "\n",
        "        self.df = df.copy()\n",
        "        self.n_partidos = len(df)\n",
        "\n",
        "        equipos = np.sort(df[\"local\"].unique())\n",
        "        n = len(equipos)\n",
        "\n",
        "        indice = {e: i for i, e in enumerate(equipos)}\n",
        "\n",
        "        local_idx = df[\"local\"].map(indice).to_numpy()\n",
        "        visitante_idx = df[\"visitante\"].map(indice).to_numpy()\n",
        "\n",
        "        goles_local = df[\"goles_local\"].to_numpy()\n",
        "        goles_visitante = df[\"goles_visitante\"].to_numpy()\n",
        "\n",
        "        parametros = np.concatenate([\n",
        "            np.random.uniform(0,0.5,n),\n",
        "            np.random.uniform(-0.5,0,n),\n",
        "            np.array([0.20,-0.05])\n",
        "        ])\n",
        "\n",
        "\n",
        "\n",
        "        # pesos temporales\n",
        "        if self.xi is None:\n",
        "            peso = np.ones(len(df))\n",
        "        else:\n",
        "            fecha = df[\"fecha\"]\n",
        "            ultima = fecha.max()\n",
        "            tiempo = (ultima-fecha).dt.days.to_numpy()\n",
        "            peso = np.exp(-self.xi*tiempo)\n",
        "\n",
        "\n",
        "\n",
        "        def loglik(param):\n",
        "\n",
        "            ataque = param[:n]\n",
        "            defensa = param[n:2*n]\n",
        "\n",
        "            gamma = param[-2]\n",
        "            rho = param[-1]\n",
        "\n",
        "            lambda_ = np.exp(\n",
        "                ataque[local_idx] +\n",
        "                defensa[visitante_idx] +\n",
        "                gamma\n",
        "            )\n",
        "\n",
        "            mu = np.exp(\n",
        "                ataque[visitante_idx] +\n",
        "                defensa[local_idx]\n",
        "            )\n",
        "\n",
        "            tau = np.ones(len(df))\n",
        "\n",
        "            m00 = (goles_local==0) & (goles_visitante==0)\n",
        "            m01 = (goles_local==0) & (goles_visitante==1)\n",
        "            m10 = (goles_local==1) & (goles_visitante==0)\n",
        "            m11 = (goles_local==1) & (goles_visitante==1)\n",
        "\n",
        "            tau[m00] = 1-lambda_[m00]*mu[m00]*rho\n",
        "            tau[m01] = 1+lambda_[m01]*rho\n",
        "            tau[m10] = 1+mu[m10]*rho\n",
        "            tau[m11] = 1-rho\n",
        "\n",
        "            tau = np.maximum(tau,1e-12)\n",
        "\n",
        "            ll = (\n",
        "                np.log(tau)\n",
        "                + poisson.logpmf(goles_local,lambda_)\n",
        "                + poisson.logpmf(goles_visitante,mu)\n",
        "            )\n",
        "\n",
        "            return -np.dot(peso,ll)\n",
        "\n",
        "        def restriccion(param):\n",
        "            return np.sum(param[:n])\n",
        "\n",
        "        cons = {\"type\":\"eq\",\"fun\":restriccion}\n",
        "\n",
        "        bounds=[(-4,4)]*(2*n)\n",
        "        bounds+=[(-1,1),(-0.2,0.2)]\n",
        "\n",
        "        opt=minimize(\n",
        "            loglik,\n",
        "            parametros,\n",
        "            method=\"SLSQP\",\n",
        "            constraints=cons,\n",
        "            bounds=bounds\n",
        "        )\n",
        "        if not opt.success:\n",
        "          raise RuntimeError(f\"La optimización no convergió: {opt.message}\")\n",
        "\n",
        "        # guardar resultados\n",
        "\n",
        "        self.ataque=dict(zip(equipos,opt.x[:n]))\n",
        "        self.defensa=dict(zip(equipos,opt.x[n:2*n]))\n",
        "\n",
        "        self.gamma=opt.x[-2]\n",
        "        self.rho=opt.x[-1]\n",
        "\n",
        "        self.logLik=-opt.fun\n",
        "        self.resultado=opt\n",
        "        self.fitted = True\n",
        "\n",
        "        self.indice=indice\n",
        "        self.n_equipos = n\n",
        "        self.equipos = equipos\n",
        "        self.parameters = pd.DataFrame({\"Equipo\": equipos,\"Ataque\": opt.x[:n],\"Defensa\": opt.x[n:2*n]})\n",
        "\n",
        "        return self\n",
        "\n",
        "    def expected_goals(\n",
        "        self,\n",
        "        equipo_local,\n",
        "        equipo_visitante):\n",
        "\n",
        "        if not self.fitted:\n",
        "            raise ValueError(\n",
        "                \"Debe ejecutar fit() antes de usar expected_goals().\"\n",
        "            )\n",
        "\n",
        "        if equipo_local not in self.ataque:\n",
        "            raise ValueError(\n",
        "                f\"El equipo '{equipo_local}' no existe.\"\n",
        "            )\n",
        "\n",
        "        if equipo_visitante not in self.ataque:\n",
        "            raise ValueError(\n",
        "                f\"El equipo '{equipo_visitante}' no existe.\"\n",
        "            )\n",
        "\n",
        "        lambda_ = np.exp(\n",
        "\n",
        "            self.ataque[equipo_local]\n",
        "            + self.defensa[equipo_visitante]\n",
        "            + self.gamma\n",
        "\n",
        "        )\n",
        "\n",
        "        mu = np.exp(\n",
        "\n",
        "            self.ataque[equipo_visitante]\n",
        "            + self.defensa[equipo_local]\n",
        "\n",
        "        )\n",
        "\n",
        "        return lambda_, mu\n",
        "\n",
        "\n",
        "\n",
        "    def predict(\n",
        "        self,\n",
        "        equipo_local,\n",
        "        equipo_visitante,\n",
        "        goles_max=7):\n",
        "\n",
        "        if not self.fitted:\n",
        "            raise ValueError(\n",
        "                \"Debe ejecutar fit() antes de usar predict().\"\n",
        "            )\n",
        "\n",
        "        lambda_x, mu_y = self.expected_goals(\n",
        "            equipo_local,\n",
        "            equipo_visitante\n",
        "        )\n",
        "\n",
        "        prob=np.zeros((goles_max+1,goles_max+1))\n",
        "\n",
        "        for i in range(goles_max+1):\n",
        "            for j in range(goles_max+1):\n",
        "\n",
        "                prob[i,j]=(\n",
        "                    poisson.pmf(i,lambda_x)\n",
        "                    *poisson.pmf(j,mu_y)\n",
        "                    *rhodixon(i,j,lambda_x,mu_y,self.rho)\n",
        "                )\n",
        "\n",
        "        return prob\n",
        "\n",
        "    def win_prob(self,\n",
        "             local,\n",
        "             visitante,\n",
        "             goles_max):\n",
        "\n",
        "        prob = self.predict(\n",
        "                local,\n",
        "                visitante,\n",
        "                goles_max\n",
        "            )\n",
        "\n",
        "        prob_local = np.tril(prob, -1).sum()\n",
        "        prob_empate = np.trace(prob)\n",
        "        prob_visitante = np.triu(prob, 1).sum()\n",
        "\n",
        "        tabla = pd.DataFrame([{\n",
        "            local: prob_local,\n",
        "            \"Empate\": prob_empate,\n",
        "            visitante: prob_visitante\n",
        "        }])\n",
        "\n",
        "        tabla[f\"Momio {local}\"] = tabla[local].apply(prob_a_american)\n",
        "        tabla[\"Momio Empate\"] = tabla[\"Empate\"].apply(prob_a_american)\n",
        "        tabla[f\"Momio {visitante}\"] = tabla[visitante].apply(prob_a_american)\n",
        "\n",
        "        return tabla\n",
        "\n",
        "    def score_matrix(self,\n",
        "                 local,\n",
        "                 visitante,\n",
        "                 goles_max=7):\n",
        "\n",
        "        prob = self.predict(\n",
        "            local,\n",
        "            visitante,\n",
        "            goles_max\n",
        "        )\n",
        "        return score_matrix(prob,local,visitante)\n",
        "\n",
        "\n",
        "\n",
        "    def summary(self):\n",
        "\n",
        "      return pd.DataFrame({\n",
        "\n",
        "        \"Parametro\":[\n",
        "            \"Modelo\",\n",
        "            \"Equipos\",\n",
        "            \"Partidos\",\n",
        "            \"Gamma\",\n",
        "            \"Rho\",\n",
        "            \"Xi\",\n",
        "            \"LogLik\",\n",
        "            \"Iteraciones\",\n",
        "            \"Convergencia\"\n",
        "        ],\n",
        "\n",
        "        \"Valor\":[\n",
        "            self.model,\n",
        "            self.n_equipos,\n",
        "            self.n_partidos,\n",
        "            self.gamma,\n",
        "            self.rho,\n",
        "            self.xi,\n",
        "            self.logLik,\n",
        "            self.resultado.nit,\n",
        "            self.resultado.success\n",
        "        ]}\n",
        "      )\n",
        "    @property\n",
        "    def teams(self):\n",
        "      if not self.fitted:\n",
        "        raise ValueError(\n",
        "            \"Debe ejecutar fit() antes de consultar los equipos.\"\n",
        "        )\n",
        "      return self.equipos.tolist()\n",
        "\n",
        "    def predict_score(\n",
        "        self,\n",
        "        local,\n",
        "        visitante,\n",
        "        goles_max=7):\n",
        "      prob = self.predict(\n",
        "      local,\n",
        "      visitante,\n",
        "      goles_max)\n",
        "      return np.unravel_index(\n",
        "          prob.argmax(),\n",
        "          prob.shape)\n",
        "\n",
        "    def __repr__(self):\n",
        "      if not self.fitted:\n",
        "        return f\"<{self.model} (no entrenado)>\"\n",
        "      return (\n",
        "        f\"<{self.model}\"\n",
        "        f\" | equipos={self.n_equipos}\"\n",
        "        f\" | partidos={self.n_partidos}\"\n",
        "        f\" | logLik={self.logLik:.2f}>\"\n",
        "    )\n"
      ]
    }
  ]
}